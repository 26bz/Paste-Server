{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./server/*"]
    }
  },
   "include": [
    "**/*.ts"
  ],
   "exclude": [
    "./fixtures/**/*.*",
    "./_fixtures/**/*.*"
  ]
}
